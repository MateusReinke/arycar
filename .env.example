# =========================
# Banco PostgreSQL (externo ao deploy)
# =========================
DATABASE_HOST=arycar_db
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=arycar_admin
DATABASE_PASSWORD=
CORS_ORIGIN=https://arycar.mrbautomacoes.site

# Segredo usado para assinar os tokens de sessão (login). Gere um valor fixo
# em produção, ex.: `openssl rand -hex 32`. Sem isso a API gera uma chave
# aleatória a cada boot e todo mundo é deslogado a cada deploy/reinício.
AUTH_TOKEN_SECRET=

# =========================
# Frontend (Vite)
# Copie para .env e ajuste se necessário
# =========================
# Webhook do Assistente Arycar (n8n ou endpoint compatível)
VITE_API_BASE_URL=https://arycar.mrbautomacoes.site/api
VITE_PLATE_API_URL=https://placas.app.br/api/v1/placas
VITE_PLATE_API_TOKEN=
VITE_FIPE_API_URL=https://parallelum.com.br/fipe/api/v1
VITE_N8N_WEBHOOK_URL=

